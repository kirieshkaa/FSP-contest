# Created by combined template for Go + Next.js (Node.js) project
# Suitable for hackathon monorepo or separate folders

## ==================== ##
##   DEPENDENCIES       ##
## ==================== ##

# Go dependencies (will be downloaded automatically)
/vendor/
# Go modules file (go.mod and go.sum should be committed, but not the vendor folder)

# Node dependencies
node_modules/
# Next.js specific (Next.js creates its own cache)
.next/

## ==================== ##
##   BUILD ARTIFACTS     ##
## ==================== ##

# Go binaries (compiled output - DO NOT COMMIT)
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
# Name of your main binary (change if your output binary name is different)
/main
/api
/server

# Next.js build output
/out
/build
/.next/static
/.next/cache

# Python (if you decide to use it for ML scripts)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.env/
.venv/
*.egg-info/
dist/
build/

## ==================== ##
##   IDE & OS FILES      ##
## ==================== ##

# VS Code (but keep shared settings if you want)
.vscode/*
!.vscode/settings.json  # uncomment if you want to share formatter settings
!.vscode/extensions.json

# IntelliJ / GoLand
.idea/
*.iml
*.iws
out/
.idea_modules/
atlassian-ide-plugin.xml

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
*.swp
*.swo
*.*~

## ==================== ##
##   LOGS & DATABASES    ##
## ==================== ##

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Local database files
*.db
*.sqlite
*.sqlite3
*.db-journal

# Environment files (CRITICAL - keep secrets out!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# Docker files (if you use them temporarily, don't commit your local overrides)
docker-compose.override.yml
Dockerfile.local

## ==================== ##
##   TEST COVERAGE       ##
## ==================== ##

# Go test coverage
*.cover.out
*.coverprofile
coverage.txt
coverage.html
cover.out

# Node test coverage
coverage/
.nyc_output/

## ==================== ##
##   TEMPORARY FILES     ##
## ==================== ##

# Backup files from editors
*~
*.bak
*.tmp
*.temp

# Archives
*.zip
*.tar
*.tar.gz
*.rar

## ==================== ##
##   HACKATHON SPECIFIC  ##
## ==================== ##

# Hackathon notes / scratchpads
/notes/
/todo.md
/scratchpad.md
/ideas.md

# Presentations and screenshots (if you keep them in repo)
*.pptx
*.key
*.pdf
/screenshots/